# Supabase project that backs PieceMark (auth, Postgres, Storage).
# Both values are safe to expose to the browser: the publishable key only ever
# acts as the signed-in user, and Row Level Security scopes every table.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Set to "false" to run without sign-in (local-only demo mode, no cloud).
# VITE_AUTH_ENABLED=true
