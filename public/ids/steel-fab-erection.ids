<?xml version='1.0' encoding='utf-8'?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>PieceMark Steel Fab &amp; Erection — Information Delivery Specification</title>
        <copyright>PieceMark / Southwest Fabricators</copyright>
        <version>1.0.0</version>
        <description>Minimum IFC information requirements for structural steel subcontractors: piece marks (Tag), naming, materials, and common property sets for columns, beams, braces, and footings.</description>
        <author>detailing@piecemark.example</author>
        <date>2026-08-01</date>
        <purpose>Validate IFC structural steel models before shop/field issue</purpose>
        <milestone>IFC for fabrication &amp; erection</milestone>
    </info>
    <specifications>
        <specification name="Column — piece mark (Tag)" ifcVersion="IFC4 IFC4X3_ADD2 IFC2X3" description="Every column shall carry a fabrication piece mark in Tag." instructions="Map Tag to piece-mark schedule / drawing register.">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCCOLUMN</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required" instructions="Piece mark e.g. C1, B12, BR-3">
                    <name>
                        <simpleValue>Tag</simpleValue>
                    </name>
                </attribute>
            </requirements>
        </specification>
        <specification name="Column — Name" ifcVersion="IFC4 IFC4X3_ADD2 IFC2X3" description="Column shall have a human-readable Name.">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCCOLUMN</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Name</simpleValue>
                    </name>
                </attribute>
            </requirements>
        </specification>
        <specification name="Column — Description" ifcVersion="IFC4 IFC4X3_ADD2 IFC2X3" description="Column shall include a Description for fabrication context.">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCCOLUMN</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Description</simpleValue>
                    </name>
                </attribute>
            </requirements>
        </specification>
        <specification name="Column — ObjectType (section / role)" ifcVersion="IFC4 IFC4X3_ADD2 IFC2X3" description="Column shall declare ObjectType (e.g. W14x90, HSS brace)." instructions="Use AISC designation or role string.">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCCOLUMN</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>ObjectType</simpleValue>
                    </name>
                </attribute>
            </requirements>
        </specification>
        <specification name="Column — Material assigned" ifcVersion="IFC4 IFC4X3_ADD2 IFC2X3" description="Column shall have an associated IfcMaterial.">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCCOLUMN</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <material cardinality="required" />
            </requirements>
        </specification>
        <specification name="Column — Pset_ColumnCommon.LoadBearing" ifcVersion="IFC4 IFC4X3_ADD2 IFC2X3" description="Column shall provide LoadBearing in Pset_ColumnCommon.">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCCOLUMN</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_ColumnCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>LoadBearing</simpleValue>
                    </baseName>
                </property>
            </requirements>
        </specification>
